# Backend Environment Variables for Render.com

# AI Service URL (set this to your Render AI service URL)
AI_SERVICE_URL=https://resume-builder-ai-0j5i.onrender.com

# Client URL (for CORS — set to your frontend Render URL)
CLIENT_URL=https://your-frontend.onrender.com

# Port (Render sets this automatically)
PORT=5000

# Node environment
NODE_ENV=production
